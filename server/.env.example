# Copy to .env and fill in real values. NEVER commit .env.
# All values here are placeholders — no real secrets.

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ridercraft

# Required for authentication. Use a long random value in production.
# PRODUCTION: rotate this secret once before going live so any tokens minted
# before JWT expiry existed are invalidated immediately.
JWT_SECRET=

# Access token lifetime (jsonwebtoken format, e.g. 15m / 1h). Default: 60m
# PRODUCTION: set to 60m on the host (Render dashboard).
JWT_EXPIRES_IN=60m

# Google OAuth (web client ID; also configured in the frontend build).
GOOGLE_CLIENT_ID=

# CORS allowlist. Each var accepts a comma-separated list of exact origins
# (scheme://host[:port], NO trailing slash, NO "*"). A request is allowed only
# if its Origin matches an entry exactly. Requests without an Origin header
# (Flutter native, server-to-server) are always permitted and never echoed.
# PRODUCTION: set these on the host to the deployed web app's exact origin(s).
# There is no default allowlist — if these are empty, all cross-origin
# browser requests are denied.
FRONTEND_URL=
CLIENT_URL=
ALLOWED_ORIGINS=

# Rate limiting (optional; defaults apply if unset)
# AUTH_RATE_MAX=20
# API_RATE_MAX=300
# RATE_WINDOW_MS=900000

# Transactional email (password reset).
#
# NOT CONFIGURED YET: there is currently NO real email provider wired into the
# server (see server/utils/emailService.js). Until a provider is registered at
# boot via setEmailProvider(), password-reset emails are NOT delivered and
# password reset is NOT production-ready. A future provider will read its
# credentials from vars such as the ones below:
# EMAIL_PROVIDER=              # e.g. resend | sendgrid | ses
# EMAIL_FROM=ridercraft@example.com
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# AWS_SES_REGION=