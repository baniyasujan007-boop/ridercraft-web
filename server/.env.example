# Copy to .env and fill in real values. NEVER commit .env.
# All values here are placeholders — no real secrets.

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ridercraft

# Required for authentication. Use a long random value in production.
JWT_SECRET=

# Access token lifetime (jsonwebtoken format, e.g. 15m / 1h). Default: 60m
JWT_EXPIRES_IN=60m

# Google OAuth
GOOGLE_CLIENT_ID=

# CORS allowlist (comma-separated if more than one).
# Set to the deployed website origin(s), e.g. https://ridercraft.example.com
# Development origins must be added explicitly as well.
FRONTEND_URL=
CLIENT_URL=
# Optional extra origins:
# ALLOWED_ORIGINS=

# Rate limiting (optional; defaults apply if unset)
# AUTH_RATE_MAX=20
# API_RATE_MAX=300
# RATE_WINDOW_MS=900000